type CarClass = "A" | "B" | "C" | "D" | "E" | "F" | "S" | "J" | "M" | "P";

// price for day
const rentalRates: Record<CarClass, number> = {
    "A": 20,  
    "B": 30,  
    "C": 40,  
    "D": 50,  
    "E": 70,  
    "F": 100, 
    "S": 150, 
    "J": 60,  
    "M": 45,  
    "P": 55   
};

// Функція для обрахунку вартості
function calculateRentalPrice(carClass: CarClass, rentalDays: number): number {
    // базова ставка для вказаного класу авто
    const baseRate = rentalRates[carClass];

    // ціна
    let totalCost = baseRate * rentalDays;

    // якщо оренда більше 7 днів знижка буде складати 10 відсотків
    if (rentalDays > 7) {
        totalCost *= 0.9;  
    }

   // так само з 30 днів
    if (rentalDays > 30) {
        totalCost *= 0.8;  
    }

    return Math.round(totalCost);  // округлення отриманої суми

}



    


class Country_Office {
    public addresses: Address[] = [];
    public employees: Person[] = [];
    public money: number;
    public phone_nums: Number[] = [];
    public application: Application[] = [];
    
    constructor(adresses: Address[], money: number, phone_nums: Number[], application: Application[]) 
    {
        this.addresses = adresses;
        this.money = money;
        this.phone_nums = phone_nums;
        this.application = application;
    }
    //TODO look to the transaction
    public transaction(customer: Profile, ammount: number): String {
        try {
        if (customer.about_person.money >= ammount) {
            customer.about_person.money -= ammount;
            this.money += ammount;
            return "Транзакція пройшла успішно"
        }
        else {
            return "Транзакція не пройшла успішно"
        }
        }
        catch (error) {
            return `Error: ${error.message}`;
        }
    }
}

type Employee = {
    id: Number;
    name: String;
    position: String;
};

class EmployeeManager {
    private employees: Employee[] = [];

    // Додає працівника до списку
    addEmployee(employee: Employee): void {
        this.employees.push(employee);
        console.log(`Працівник ${employee.name} доданий до списку.`);
    }

    // Видаляє працівника зі списку за ID
    removeEmployee(id: number): void {
        const index = this.employees.findIndex(emp => emp.id === id);
        if (index !== -1) {
            const removedEmployee = this.employees.splice(index, 1)[0];
            console.log(`Працівник ${removedEmployee.name} видалений зі списку.`);
        } else {
            console.log(`Працівника з ID ${id} не знайдено.`);
        }
    }

    // Виводить список всіх працівників
    listEmployees(): void {
        console.log("Список працівників:");
        this.employees.forEach(employee => {
            console.log(`ID: ${employee.id}, Ім'я: ${employee.name}, Посада: ${employee.position}`);
        });
    }
}


